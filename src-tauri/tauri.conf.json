{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyPrint",
  "version": "0.1.0",
  "identifier": "com.polyprint.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "PolyPrint", "width": 1440, "height": 900, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' thumbnail: http://thumbnail.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": { "active": false }
}
